    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@uidotdev/usehooks": "^2.4.1",
    "@vidstack/react": "^1.12.13",
    "class-variance-authority": "^0.7.1",
