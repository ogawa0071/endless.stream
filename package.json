    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "livekit-client": "^2.15.8",
    "livekit-server-sdk": "^2.14.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.4",
